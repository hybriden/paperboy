# Paperboy environment — REFERENCE for local `pnpm dev` (NODE_ENV=development).
#
# Don't copy this to .env for a Docker run: the secrets below are committed
# placeholders, and under NODE_ENV=production the API refuses to boot on them and
# the seed refuses to create the published demo login (both are public constants).
# Run `./scripts/setup.sh` (or `.\scripts\setup.ps1`) instead — it generates a .env
# with unique secrets and your own admin password.
NODE_ENV=development

# Database
DATABASE_URL=postgresql://paperboy:paperboy@localhost:5433/paperboy

# API
API_PORT=8091
SESSION_SECRET=dev-session-secret-change-me-min-32-chars-long
CSRF_SECRET=dev-csrf-secret-change-me-min-32-chars-long
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:8090

# Admin SPA
VITE_API_URL=http://localhost:8091

# Web (Next.js reference frontend)
PAPERBOY_API_URL=http://localhost:8091
PAPERBOY_PUBLIC_KEY=pk_live_seed_public_key_value
PAPERBOY_PREVIEW_KEY=prv_seed_preview_key_value
# Signs/verifies the short-lived preview tokens the admin iframe uses. The SAME
# value must be set on the api and the web frontend. Never exposed to the browser.
PREVIEW_SECRET=dev-preview-secret-change-me

# Which peers may set X-Forwarded-For for req.ip (rate-limit keys and audit IPs)
# and request.host/protocol. "true" trusts ALL hops — a client reaching the API
# directly can then spoof them. Use a value that VALIDATES THE PEER: a CSV of
# proxy IPs/CIDRs, a preset (loopback, linklocal, uniquelocal), or "false" for
# none. A hop count ("1") is refused: it ignores the connecting address and was
# spoofable (GHSA-3m5p-2c4r-xxw2).
# "uniquelocal" = the private ranges, which is what a container network is. Note
# what it does NOT cover: docker NATs a published port, so a request from your
# LAN to :8091 also arrives from a private address. If this origin is reachable
# outside the proxy chain, stop publishing the port rather than tuning this.
TRUST_PROXY=uniquelocal
WEB_PORT=8092

# Stock images (optional): Unsplash access key fallback — a key stored in the
# CMS (Settings → Stock images) takes precedence. Demo keys: 50 requests/hour.
# UNSPLASH_ACCESS_KEY=

# Rate limits (per IP per minute). Defaults are production-safe; CI e2e runs
# raise both so one runner IP can drive the whole suite without 429 flakes.
# LOGIN_RATE_MAX=10
# RATE_LIMIT_MAX=300

# Seed admin user (created by db:seed)
SEED_ADMIN_EMAIL=admin@paperboy.test
SEED_ADMIN_PASSWORD=Admin!Passw0rd
