# Paperboy environment — REFERENCE for local `pnpm dev` (NODE_ENV=development).
#
# Don't copy this to .env for a Docker run: the secrets below are committed
# placeholders, and under NODE_ENV=production the API refuses to boot on them and
# the seed refuses to create the published demo login (both are public constants).
# Run `./scripts/setup.sh` (or `.\scripts\setup.ps1`) instead — it generates a .env
# with unique secrets and your own admin password.
NODE_ENV=development

# Database
DATABASE_URL=postgresql://paperboy:paperboy@localhost:5433/paperboy

# API
API_PORT=8091
SESSION_SECRET=dev-session-secret-change-me-min-32-chars-long
CSRF_SECRET=dev-csrf-secret-change-me-min-32-chars-long
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:8090
# Escape hatch for a non-TLS internal/LAN demo: production refuses to boot with
# COOKIE_SECURE=false unless this is explicitly true.
# ALLOW_INSECURE_COOKIES=false
# Encrypts TOTP secrets and the stored AI/stock keys at rest (AES-256-GCM KEK).
# Unset = derived from SESSION_SECRET. Pin it before rotating SESSION_SECRET —
# changing it makes existing 2FA enrolments and stored keys undecryptable.
# MFA_SECRET=
# Browser-reachable base for media URLs. Empty = relative (/api/v1/media/…),
# which resolves same-origin through each app's proxy and works on any host.
# MEDIA_PUBLIC_BASE=
# Where uploads live (the compose volume mounts here).
# UPLOADS_DIR=/app/uploads

# AI writing assistant (optional): Anthropic OR any OpenAI-compatible endpoint.
# Each key is bound to its own provider; AI_PROVIDER (anthropic | openai) picks
# when both are set. A config stored in the CMS (Settings → AI) wins over these.
# AI_MODEL empty = the per-provider default.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AI_PROVIDER=
# AI_MODEL=

# Forms. Submissions per IP per FORM per minute; the Cloudflare Turnstile SECRET
# (the SITE key belongs to the frontend — NEXT_PUBLIC_TURNSTILE_SITE_KEY below).
# A form that requires a challenge with no secret configured REFUSES submissions.
# FORM_SUBMIT_RATE_MAX=10
# TURNSTILE_SECRET_KEY=
# Retention, in days. Submissions default to one year (GDPR storage limitation);
# webhook_delivery is delivery noise; audit_log is the compliance trail, so 0
# keeps everything until an operator opts in.
# SUBMISSION_RETENTION_DAYS=365
# WEBHOOK_DELIVERY_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=0
# Webhooks may target private/loopback addresses (turns the SSRF guard off —
# only for a receiver on the same internal network).
# PAPERBOY_WEBHOOK_ALLOW_PRIVATE=false

# Admin SPA
VITE_API_URL=http://localhost:8091

# Web (Next.js reference frontend)
PAPERBOY_API_URL=http://localhost:8091
PAPERBOY_PUBLIC_KEY=pk_live_seed_public_key_value
PAPERBOY_PREVIEW_KEY=prv_seed_preview_key_value
# Signs/verifies the short-lived preview tokens the admin iframe uses. The SAME
# value must be set on the api and the web frontend. Never exposed to the browser.
PREVIEW_SECRET=dev-preview-secret-change-me
# Admin origins allowed to embed the preview iframe (CSP frame-ancestors),
# comma-separated; the first one is the admin the on-page-editing bridge trusts.
# ADMIN_ORIGINS=
# Public origin of the site, for the absolute URLs in JSON-LD (@id/url/breadcrumb
# items). Unset in production those values are omitted, never a localhost URL.
# SITE_ORIGIN=
# Cloudflare Turnstile SITE key (public), for forms that require a challenge.
# Next inlines NEXT_PUBLIC_* only when set at `next build`, and the compose image
# is built without it — so the reference frontend reads this one on the server
# per request and passes it to the form: the container's runtime env is what
# counts. A custom frontend reading it in a client component must set it at build.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Which peers may set X-Forwarded-For for req.ip (rate-limit keys and audit IPs)
# and request.host/protocol. "true" trusts ALL hops — a client reaching the API
# directly can then spoof them. Use a value that VALIDATES THE PEER: a CSV of
# proxy IPs/CIDRs, a preset (loopback, linklocal, uniquelocal), or "false" for
# none. A hop count ("1") is refused: it ignores the connecting address and was
# spoofable (GHSA-3m5p-2c4r-xxw2).
# "uniquelocal" = the private ranges, which is what a container network is. Note
# what it does NOT cover: docker NATs a published port, so a request from your
# LAN to :8091 also arrives from a private address. If this origin is reachable
# outside the proxy chain, stop publishing the port rather than tuning this.
TRUST_PROXY=uniquelocal

# Stock images (optional): Unsplash access key fallback — a key stored in the
# CMS (Settings → Stock images) takes precedence. Demo keys: 50 requests/hour.
# UNSPLASH_ACCESS_KEY=

# Rate limits (per IP per minute). Defaults are production-safe; CI e2e runs
# raise both so one runner IP can drive the whole suite without 429 flakes.
# LOGIN_RATE_MAX=10
# RATE_LIMIT_MAX=300

# Seed admin user (created by db:seed)
SEED_ADMIN_EMAIL=admin@paperboy.test
SEED_ADMIN_PASSWORD=Admin!Passw0rd
# Which frontend the admin's preview pane frames (default: the Astro starter).
# SITE_PREVIEW_URL=http://localhost:4321
# A production seed refuses the published demo logins/keys above; true opts a
# throwaway demo/CI stack back in.
# ALLOW_DEMO_CREDENTIALS=false
# The seed CLI skips a database that already holds content; 1 wipes and reseeds.
# FORCE_SEED=0

# MCP (optional). A token minted in Settings → MCP; the HTTP transport
# (`--profile mcp`) refuses to start without one.
# MCP_TOKEN=
